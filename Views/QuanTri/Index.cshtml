@model List<DonHang>
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý Hóa Đơn & Đơn Hàng";
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    string currentFilter = ViewBag.TrangThai ?? "Tất cả";
    string searchKey = ViewBag.TimKiem ?? "";
}

<div class="container-fluid py-4 px-lg-5">
    <!-- Header Admin -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-danger">ADMIN DASHBOARD</span>
                <h2 class="fw-bold text-dark mb-0 font-serif">QUẢN LÝ HÓA ĐƠN & ĐƠN HÀNG</h2>
            </div>
            <div class="text-muted small mt-1">
                Tài khoản: <b>@User.Identity?.Name</b> (Quản trị viên hệ thống bán sách)
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/QuanTri/QuanLyFeedback" class="btn btn-outline-warning text-dark fw-semibold">
                <i class="bi bi-chat-heart me-1"></i> Quản lý Đánh giá
            </a>
            <a href="/" target="_blank" class="btn btn-outline-primary">
                <i class="bi bi-box-arrow-up-right me-1"></i> Xem trang Landing
            </a>
        </div>
    </div>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMsg"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 4 Thẻ Thống Kê KPI Doanh Thu & Hóa Đơn -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Tổng Hóa Đơn</div>
                        <div class="display-6 fw-bold">@ViewBag.TongDon</div>
                    </div>
                    <i class="bi bi-receipt-cutoff fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card bg-warning text-dark">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-dark small fw-bold text-uppercase" style="opacity: 0.8;">Hóa Đơn Mới (Chờ duyệt)</div>
                        <div class="display-6 fw-bold">@ViewBag.DonMoi</div>
                    </div>
                    <i class="bi bi-hourglass-split fs-1 text-dark" style="opacity: 0.6;"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card bg-success text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Đã Giao Thành Công</div>
                        <div class="display-6 fw-bold">@ViewBag.DaGiao</div>
                    </div>
                    <i class="bi bi-check2-circle fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card bg-dark text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Tổng Doanh Thu</div>
                        <div class="fs-3 fw-bold text-warning">@(((long)ViewBag.TongDoanhThu).ToString("N0", vn)) đ</div>
                    </div>
                    <i class="bi bi-cash-coin fs-1 text-warning" style="opacity: 0.8;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ Lọc & Tìm Kiếm Hóa Đơn -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-lg-4">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-5 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="timKiem" value="@searchKey" class="form-control" placeholder="Tìm theo tên khách, SĐT, mã hóa đơn..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <select name="trangThai" class="form-select" onchange="this.form.submit()">
                        <option value="Tất cả" selected="@(currentFilter == "Tất cả")">Tất cả trạng thái</option>
                        <option value="Chờ xử lý" selected="@(currentFilter == "Chờ xử lý")">Chờ xử lý</option>
                        <option value="Đang giao" selected="@(currentFilter == "Đang giao")">Đang giao</option>
                        <option value="Đã giao" selected="@(currentFilter == "Đã giao")">Đã giao</option>
                        <option value="Đã hủy" selected="@(currentFilter == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-3 col-lg-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel"></i> Lọc dữ liệu
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(searchKey) || currentFilter != "Tất cả")
                {
                    <div class="col-md-12 col-lg-3">
                        <a href="/QuanTri" class="text-danger small text-decoration-none">
                            <i class="bi bi-x-circle"></i> Xóa bộ lọc
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Danh Sách Hóa Đơn Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-receipt me-2 text-primary"></i>Danh Sách Hóa Đơn (@Model.Count)
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-custom mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Ngày Đặt</th>
                        <th>Khách Hàng</th>
                        <th>Tài Khoản</th>
                        <th>Số Điện Thoại</th>
                        <th>Địa Chỉ Giao</th>
                        <th>SL</th>
                        <th>Thanh Toán</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            string badgeClass = item.TrangThai switch
                            {
                                "Chờ xử lý" => "badge-cho-xu-ly",
                                "Đang giao" => "badge-dang-giao",
                                "Đã giao" => "badge-da-giao",
                                _ => "badge-da-huy"
                            };

                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td class="small text-muted">@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.HoTen</div>
                                    @if (!string.IsNullOrEmpty(item.GhiChu))
                                    {
                                        <small class="text-muted fst-italic">Note: @item.GhiChu</small>
                                    }
                                </td>
                                <td>
                                    @if (item.NguoiDung != null)
                                    {
                                        <span class="badge bg-light text-primary border">@@@item.NguoiDung.TenDangNhap</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Khách vãng lai</span>
                                    }
                                </td>
                                <td>
                                    <a href="tel:@item.SoDienThoai" class="text-primary text-decoration-none fw-semibold">
                                        @item.SoDienThoai
                                    </a>
                                </td>
                                <td class="small text-muted" style="max-width: 200px; white-space: normal;">
                                    @item.DiaChi
                                </td>
                                <td class="fw-bold text-center">@item.SoLuong</td>
                                <td>
                                    <span class="badge @(item.PhuongThucThanhToan == "COD" ? "bg-light text-dark border" : "bg-primary-subtle text-primary border border-primary")">
                                        @item.PhuongThucThanhToan
                                    </span>
                                </td>
                                <td class="fw-bold text-danger">@item.TongTien.ToString("N0", vn) đ</td>
                                <td>
                                    <span class="badge badge-status @badgeClass">@item.TrangThai</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/QuanTri/ChiTietHoaDon/@item.Id" class="btn btn-outline-secondary" title="Xem chi tiết hóa đơn">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.TrangThai == "Chờ xử lý")
                                        {
                                            <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="trangThaiMoi" value="Đang giao" />
                                                <input type="hidden" name="trangThaiHienTai" value="@currentFilter" />
                                                <input type="hidden" name="timKiem" value="@searchKey" />
                                                <button type="submit" class="btn btn-outline-primary" title="Duyệt giao hàng">
                                                    <i class="bi bi-truck"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (item.TrangThai == "Đang giao" || item.TrangThai == "Chờ xử lý")
                                        {
                                            <form asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="trangThaiMoi" value="Đã giao" />
                                                <input type="hidden" name="trangThaiHienTai" value="@currentFilter" />
                                                <input type="hidden" name="timKiem" value="@searchKey" />
                                                <button type="submit" class="btn btn-outline-success" title="Xác nhận Đã Giao">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (item.TrangThai != "Đã hủy" && item.TrangThai != "Đã giao")
                                        {
                                            <form asp-action="CapNhatTrangThai" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy hóa đơn này?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="trangThaiMoi" value="Đã hủy" />
                                                <input type="hidden" name="trangThaiHienTai" value="@currentFilter" />
                                                <input type="hidden" name="timKiem" value="@searchKey" />
                                                <button type="submit" class="btn btn-outline-danger" title="Hủy hóa đơn">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy hóa đơn nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
