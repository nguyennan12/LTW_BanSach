@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden my-3">
                <div class="bg-primary text-white text-center p-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle mb-3 shadow" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-plus-fill fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-1">TẠO TÀI KHOẢN MỚI</h4>
                    <p class="small text-white-50 mb-0">Đăng ký thành viên để mua sách nhanh chóng và theo dõi đơn hàng</p>
                </div>

                <div class="p-4 p-lg-5">
                    <form asp-action="DangKy" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold small" asp-for="TenDangNhap"></label>
                                <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên tài khoản..." />
                                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small" asp-for="MatKhau"></label>
                                <input asp-for="MatKhau" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." />
                                <span asp-validation-for="MatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small" asp-for="XacNhanMatKhau"></label>
                                <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu..." />
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small" asp-for="HoTen"></label>
                                <input asp-for="HoTen" class="form-control" placeholder="Họ và tên..." />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold small" asp-for="SoDienThoai"></label>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="0987654321" />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold small" asp-for="DiaChi"></label>
                                <input asp-for="DiaChi" class="form-control" placeholder="Địa chỉ giao nhận hàng mặc định..." />
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm">
                                    <i class="bi bi-check-circle me-1"></i> Hoàn Tất Đăng Ký
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="text-center mt-3 pt-3 border-top">
                        <span class="small text-muted">Đã có tài khoản?</span>
                        <a href="/Account/DangNhap" class="small fw-bold text-primary text-decoration-none ms-1">Đăng nhập tại đây</a>
                    </div>
                </div>
            </div>

            <div class="text-center mt-2">
                <a href="/" class="text-muted text-decoration-none small">
                    <i class="bi bi-arrow-left"></i> Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
