@model List<DonHang>
@using System.Globalization
@{
    ViewData["Title"] = "Lịch Sử Đơn Hàng Của Bạn";
    var vn = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold text-dark font-serif mb-1">LỊCH SỬ ĐƠN HÀNG CỦA BẠN</h2>
                    <p class="text-muted small mb-0">Theo dõi trạng thái các đơn đặt mua sách của tài khoản <b>@User.Identity?.Name</b></p>
                </div>
                <a href="/#dat-hang" class="btn btn-warning fw-bold text-dark rounded-pill px-3 shadow-sm">
                    <i class="bi bi-cart-plus me-1"></i> Đặt thêm sách
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã Hóa Đơn</th>
                                <th>Ngày Đặt</th>
                                <th>Sách</th>
                                <th>SL</th>
                                <th>Tổng Tiền</th>
                                <th>Thanh Toán</th>
                                <th>Trạng Thái</th>
                                <th class="text-end">Chi Tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    string badgeClass = item.TrangThai switch
                                    {
                                        "Chờ xử lý" => "badge-cho-xu-ly",
                                        "Đang giao" => "badge-dang-giao",
                                        "Đã giao" => "badge-da-giao",
                                        _ => "badge-da-huy"
                                    };

                                    <tr>
                                        <td class="fw-bold">#@item.Id</td>
                                        <td class="small text-muted">@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <div class="fw-semibold text-dark">@(item.Sach?.Ten ?? "Nhà Giả Kim")</div>
                                            <small class="text-muted">Giao đến: @item.DiaChi</small>
                                        </td>
                                        <td class="fw-bold text-center">@item.SoLuong</td>
                                        <td class="fw-bold text-danger">@item.TongTien.ToString("N0", vn) đ</td>
                                        <td>
                                            <span class="badge @(item.PhuongThucThanhToan == "COD" ? "bg-light text-dark border" : "bg-primary-subtle text-primary border border-primary")">
                                                @item.PhuongThucThanhToan
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge badge-status @badgeClass">@item.TrangThai</span>
                                        </td>
                                        <td class="text-end">
                                            <a href="/Home/CamOn/@item.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                                <i class="bi bi-eye"></i> Hóa đơn
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                        Bạn chưa có đơn đặt mua sách nào.
                                        <div class="mt-2">
                                            <a href="/#dat-hang" class="btn btn-sm btn-primary rounded-pill">Đặt sách ngay hôm nay</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
