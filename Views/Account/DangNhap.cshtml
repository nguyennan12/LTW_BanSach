@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden my-3">
                <div class="bg-primary text-white text-center p-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle mb-3 shadow" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-fill-lock fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-1">ĐĂNG NHẬP</h4>
                    <p class="small text-white-50 mb-0">Đăng nhập tài khoản User hoặc Admin</p>
                </div>

                <div class="p-4">
                    @if (TempData["ErrorMsg"] != null)
                    {
                        <div class="alert alert-warning small d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-info-circle-fill"></i>
                            <div>@TempData["ErrorMsg"]</div>
                        </div>
                    }

                    <form asp-action="DangNhap" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small" asp-for="TenDangNhap"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập..." autofocus />
                            </div>
                            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small" asp-for="MatKhau"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                <input asp-for="MatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu..." />
                            </div>
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="GhiNho" class="form-check-input" />
                            <label class="form-check-label small text-muted" asp-for="GhiNho">Ghi nhớ đăng nhập (7 ngày)</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Ngay
                        </button>
                    </form>

                    <div class="text-center mt-3 pt-3 border-top">
                        <span class="small text-muted">Chưa có tài khoản?</span>
                        <a href="/Account/DangKy" class="small fw-bold text-primary text-decoration-none ms-1">Đăng ký ngay</a>
                    </div>
                </div>
            </div>

            <div class="text-center mt-2">
                <a href="/" class="text-muted text-decoration-none small">
                    <i class="bi bi-arrow-left"></i> Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
